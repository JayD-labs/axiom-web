{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiom Web V1.4 offline contract (draft)",
  "description": "Offline instruction export contract only. This is not a ChatGPT manifest and is not installable by ChatGPT.",
  "type": "object",
  "required": ["format", "formatVersion", "agents", "skills", "settings"],
  "properties": {
    "format": {"const": "axiom-web-private-package"},
    "formatVersion": {"const": "0.1.0-draft"},
    "agents": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "skills": {"type": "array", "items": {"type": "string", "pattern": "^axiom-[a-z0-9-]+$"}},
    "settings": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
